# PostgreSQL connection
DATABASE_URL=postgres://aim:aim@localhost:5432/aim_hr
# 32+ random chars — signs admin/employee JWTs
JWT_SECRET=change-me-to-a-long-random-string-please
# 32-byte key, base64 (openssl rand -base64 32) — encrypts fingerprint templates at rest
BIOMETRIC_KEY=
# Optional — enables the admin AI chat
ANTHROPIC_API_KEY=
PORT=4000
# Comma-separated allowed browser origins in dev (web on Vite :5173)
CORS_ORIGINS=http://localhost:5173
# AI Marketing / CRM messaging: "log" (default — messages are recorded as simulated, nothing is sent) or "semaphore"
SMS_PROVIDER=log
# Semaphore (semaphore.co) API key, used when SMS_PROVIDER=semaphore. Register your sender name with Semaphore first.
SEMAPHORE_API_KEY=
# Secret for the inbound SMS webhook that records STOP replies: POST /api/crm/inbound/sms?key=<secret>
CRM_INBOUND_SECRET=
# Hourly automation runner inside the API process (on/off)
CRM_AUTOMATIONS=on
